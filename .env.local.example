# Hango — local environment

# Create a project at https://supabase.com, then paste values from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# LiveKit (voice/video) — create a free project at https://cloud.livekit.io
# Project Settings → Keys: copy URL, API Key, API Secret
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=your_api_secret
